{
  "opencollection": "1.0.0",
  "info": {
    "name": "APIContext Platform Agents Reports API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "_token",
      "value": "{{_token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://client.apimetrics.io/api/2/reports/"
          },
          "docs": "List generated SLO and performance reports."
        },
        {
          "info": {
            "name": "Get a report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://client.apimetrics.io/api/2/reports/:report_id",
            "params": [
              {
                "name": "report_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a generated SLO or performance report by id."
        }
      ]
    }
  ],
  "bundled": true
}