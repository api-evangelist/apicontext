{
  "opencollection": "1.0.0",
  "info": {
    "name": "APIContext Platform Agents Projects API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "_token",
      "value": "{{_token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Projects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
